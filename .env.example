# Environment Variables - Template

# Copia este archivo como .env en backend/ para desarrollo local
# Para producción, configura estas variables en tu plataforma de hosting

# ========== APLICACIÓN ==========

# Versión API
API_V1_STR=/api/v1

# Nombre del proyecto
PROJECT_NAME=Enmask SDM Platform

# Descripción
PROJECT_DESCRIPTION=Static Data Masking Platform for Hybrid Architectures

# ========== SEGURIDAD ==========

# Clave secreta para JWT (IMPORTANTE: genera una clave segura)
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=tu_clave_secreta_muy_larga_y_aleatoria_aqui_cambiar_en_produccion

# ========== ADMINISTRACIÓN ==========

# Emails de administradores (separados por comas)
ADMIN_EMAILS=admin@ejemplo.com,otro_admin@ejemplo.com

# ========== BASE DE DATOS METADATA (MongoDB) ==========

# Tipo de repositorio: mongodb o postgresql
REPOSITORY_BACKEND=mongodb

# URI de conexión MongoDB
# Formato: mongodb+srv://usuario:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# Para local: mongodb://localhost:27017
MONGODB_META_URI=mongodb+srv://usuario:password@cluster.mongodb.net/enmask_meta?retryWrites=true&w=majority

# Nombre de la base de datos
METADATA_DATABASE=enmask_meta

# ========== API KEY ==========

# API Key para autenticación de servicios externos (opcional)
API_KEY=tu_api_key_aqui

# ========== CORS ==========

# Orígenes permitidos para CORS (separados por comas)
# Desarrollo: http://localhost:5173,http://localhost:3000
# Producción: https://tu-frontend.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ========== LOGGING ==========

# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Archivo de logs (vacío = stderr)
LOG_FILE=

# ========== REDIS (Celery) ==========

# URL de Redis (para tareas asincrónicas)
# Local: redis://localhost:6379/0
# Production: redis://default:password@host:port
REDIS_URL=redis://localhost:6379/0

# ========== CELERY ==========

# Broker de Celery (puede ser Redis o RabbitMQ)
CELERY_BROKER_URL=redis://localhost:6379/0

# Backend de resultado de Celery
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========== DESARROLLO ==========

# Debug mode (NUNCA en producción)
DEBUG=False

# Ambiente: development, staging, production
ENVIRONMENT=development

# ========== JWT ==========

# Algoritmo para JWT
JWT_ALGORITHM=HS256

# Tiempo de expiración del token en minutos
JWT_EXPIRATION_MINUTES=30

# ========== MÁXIMOS Y LÍMITES ==========

# Tamaño máximo de archivo a procesar (en MB)
MAX_FILE_SIZE_MB=100

# Máximo número de registros a procesar por job
MAX_RECORDS_PER_JOB=1000000

# Timeout para operaciones de BD (segundos)
DB_TIMEOUT_SECONDS=30

# ========== NOTIFICACIONES (Opcional) ==========

# Email para notificaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ========== TRACKING Y ANALYTICS (Opcional) ==========

# Sentry DSN para error tracking
SENTRY_DSN=

# ========== TERCEROS ==========

# OpenAI API Key (si usas AI)
OPENAI_API_KEY=

# Stripe API Key (si usas pagos)
STRIPE_API_KEY=

# ========== VARIABLES DE PRODUCCIÓN ==========

# Dominio en producción
DOMAIN=enmask-platform.com

# URL base de la aplicación
APP_URL=https://enmask-platform.com

# Usar HTTPS
SECURE_SSL_REDIRECT=True

# ========== BASES DE DATOS DESTINO (Para enmascaramiento) ==========

# Ejemplos de conexiones a bases de datos que van a ser enmascaradas
# Estos se configuran desde la UI de la aplicación

# PostgreSQL de ejemplo
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/database

# MongoDB de ejemplo
# MONGO_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/database

# ========== NOTAS ==========

# Para desarrollo local:
# 1. Copia este archivo como .env
# 2. Reemplaza los valores con tus datos locales
# 3. NO commits .env a Git (ya está en .gitignore)

# Para producción:
# 1. En tu plataforma de hosting (Vercel, Railway, Render):
#    - Vete a Environment Variables
#    - Agrega cada variable de la sección "VARIABLES DE PRODUCCIÓN"
#    - Usa valores seguros y reales

# Seguridad:
# - NUNCA hagas commit de .env real
# - NUNCA compartas SECRET_KEY públicamente
# - NUNCA uses credenciales de desarrollo en producción
# - NUNCA commits contraseñas en este archivo
